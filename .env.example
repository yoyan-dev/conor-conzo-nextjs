# Final HTTPS origin, no trailing slash. Leave blank until confirmed.
SITE_URL=
# Enable only for the production site. Vercel previews are always noindex.
ENABLE_INDEXING=false
# Optional public HTTPS scheduling URL. Otherwise the site offers email enquiries.
BOOKING_URL=

# Gmail account and a fresh Google App Password. Server-only; never use NEXT_PUBLIC_.
SMTP_USER=
SMTP_APP_PASSWORD=
